<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/contenedor_principal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/Layoutuno" />

    <LinearLayout
        android:id="@+id/Layoutuno"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#D2B48C"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/Layoutdos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/IconoMap"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@android:drawable/ic_dialog_map"/>
            <TextView
                android:id="@+id/NombreMapa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ubicación"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/Layouttres"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/Iconocafeterias"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@android:drawable/ic_menu_agenda"/>
            <TextView
                android:id="@+id/Nombrecafe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cafeterías"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/Layoutcuatro"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/Iconoperfil"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@android:drawable/ic_menu_myplaces"/>
            <TextView
                android:id="@+id/Nombreperfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>