<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema_fondo">

    <!-- HEADER SUPERIOR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_detalle"
        style="@style/EstiloContenedorHeader"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_volver_detalle"
            style="@style/EstiloIconoHeaderBlanco"
            android:layout_marginStart="16dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txt_header_titulo"
            style="@style/EstiloTituloHeader"
            android:text="@string/app_name"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_detalle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- BANNER PRINCIPAL -->
            <ImageView
                android:id="@+id/img_banner_cafe"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/cafe_suave"
                android:scaleType="centerCrop" />

            <!-- PESTAÑAS (TABS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tab_informacion"
                    style="@style/EstiloPestanaActiva"
                    android:layout_marginEnd="16dp"
                    android:text="Información" />

                <TextView
                    android:id="@+id/tab_comentarios"
                    style="@style/EstiloPestanaInactiva"
                    android:text="Comentarios" />
            </LinearLayout>

            <!-- ZONA DE INFORMACIÓN -->
            <LinearLayout
                android:id="@+id/layout_informacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@+id/btn_favorito_detalle">

                                <TextView
                                    android:id="@+id/txt_detalle_nombre"
                                    style="@style/EstiloTituloDetalle"
                                    android:text="Nombre del Café" />

                                <TextView
                                    android:id="@+id/txt_detalle_direccion"
                                    style="@style/EstiloSubtituloDetalle"
                                    android:text="Dirección del local" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/btn_favorito_detalle"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:padding="8dp"
                                android:src="@drawable/ic_corazon"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                app:tint="@color/cafe_suave" />
                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"
                            android:background="@color/crema_fondo"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="☕ Detalles"
                            android:textColor="@color/cafe_claro_texto"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_detalle_descripcion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="6dp"
                            android:text="Cargando..."
                            android:textColor="@color/cafe_oscuro_texto"
                            android:textSize="15sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ZONA DE COMENTARIOS -->
            <LinearLayout
                android:id="@+id/layout_comentarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_comentarios"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/input_nuevo_comentario"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/fondo_redondeado_crema"
                        android:backgroundTint="@color/white"
                        android:hint="Escribe tu comentario..."
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/cafe_oscuro_texto"
                        android:textColorHint="@color/cafe_suave"
                        android:textSize="14sp"
                        android:elevation="2dp"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_enviar_comentario"
                        style="@style/EstiloBotonEnviar"
                        android:layout_marginStart="12dp"
                        android:text="Enviar" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>