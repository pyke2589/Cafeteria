<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF5EB">

    <!-- CABECERA DEL PERFIL -->
    <LinearLayout
        android:id="@+id/header_perfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#3E2723"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/fondo_redondeado_crema"
            android:backgroundTint="#8D6E63"
            android:padding="24dp"
            android:src="@drawable/icono_perfil"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/txt_perfil_nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Cargando..."
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_perfil_correo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="cargando@correo.com"
            android:textColor="#D7CCC8"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txt_perfil_telefono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Teléfono: ..."
            android:textColor="#D7CCC8"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- BOTÓN VOLVER (Izquierda) -->
    <ImageView
        android:id="@+id/btn_volver_perfil"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- BOTÓN CERRAR SESIÓN (Derecha) -->
    <ImageView
        android:id="@+id/btn_cerrar_sesion"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:src="@android:drawable/ic_lock_power_off"
        app:tint="#E3C9B8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- PESTAÑAS -->
    <LinearLayout
        android:id="@+id/layout_tabs_perfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/header_perfil">

        <TextView
            android:id="@+id/tab_favoritos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/fondo_redondeado_crema"
            android:backgroundTint="#8D6E63"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="❤️ Mis Favoritos"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:elevation="2dp" />

        <TextView
            android:id="@+id/tab_mis_comentarios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_redondeado_crema"
            android:backgroundTint="#D7CCC8"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="💬 Mis Comentarios"
            android:textColor="#5D4037"
            android:textStyle="bold"
            android:elevation="2dp" />
    </LinearLayout>

    <!-- LISTA DE FAVORITOS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_perfil_favoritos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_tabs_perfil" />

    <!-- LISTA DE MIS COMENTARIOS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_perfil_comentarios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_tabs_perfil" />

</androidx.constraintlayout.widget.ConstraintLayout>