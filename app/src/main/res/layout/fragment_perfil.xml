<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema_fondo">

    <!-- CABECERA DEL PERFIL -->
    <LinearLayout
        android:id="@+id/header_perfil"
        style="@style/EstiloHeaderPerfil"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            style="@style/EstiloImagenPerfil"
            android:src="@drawable/icono_perfil"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/txt_perfil_nombre"
            style="@style/EstiloTituloPerfil"
            android:text="Cargando..." />

        <TextView
            android:id="@+id/txt_perfil_correo"
            style="@style/EstiloSubtituloPerfil"
            android:text="cargando@correo.com" />

        <!-- Para el teléfono, hereda el estilo base pero ajustamos un poco el tamaño -->
        <TextView
            android:id="@+id/txt_perfil_telefono"
            style="@style/EstiloSubtituloPerfil"
            android:textSize="14sp"
            android:text="Teléfono: ..." />
    </LinearLayout>

    <!-- BOTÓN VOLVER (Izquierda) -->
    <ImageView
        android:id="@+id/btn_volver_perfil"
        style="@style/EstiloIconoHeaderBlanco"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- BOTÓN CERRAR SESIÓN (Derecha) -->
    <ImageView
        android:id="@+id/btn_cerrar_sesion"
        style="@style/EstiloIconoHeaderBlanco"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_lock_power_off"
        app:tint="@color/crema_boton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- PESTAÑAS -->
    <LinearLayout
        android:id="@+id/layout_tabs_perfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/header_perfil">

        <TextView
            android:id="@+id/tab_favoritos"
            style="@style/EstiloPestanaPerfilActiva"
            android:layout_marginEnd="16dp"
            android:text="❤️ Mis Favoritos" />

        <TextView
            android:id="@+id/tab_mis_comentarios"
            style="@style/EstiloPestanaPerfilInactiva"
            android:text="💬 Mis Comentarios" />
    </LinearLayout>

    <!-- LISTA DE FAVORITOS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_perfil_favoritos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_tabs_perfil" />

    <!-- LISTA DE MIS COMENTARIOS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_perfil_comentarios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_tabs_perfil" />

</androidx.constraintlayout.widget.ConstraintLayout>