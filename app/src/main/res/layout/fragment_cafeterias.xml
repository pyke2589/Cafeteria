<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema_fondo">

    <ImageView
        android:id="@+id/logo_superior_cafe"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/logocoffeespot2"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- BOTÓN VOLVER (Usando el EstiloIconoBoton transparente que ya teníamos) -->
    <ImageView
        android:id="@+id/btn_volver_cafeterias"
        style="@style/EstiloIconoBoton"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="@color/cafe_claro_texto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_superior_cafe"/>

    <!-- NUEVO BOTÓN MENÚ DE FILTROS (Usando el nuevo estilo redondo) -->
    <ImageView
        android:id="@+id/btn_menu_filtro"
        style="@style/EstiloIconoAccionRedondeado"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:src="@android:drawable/ic_menu_sort_by_size"
        app:tint="@color/cafe_oscuro_texto"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_superior_cafe"/>

    <!-- TUS 3 BOTONES ORIGINALES (Limpiados y con AppCompatButton) -->
    <LinearLayout
        android:id="@+id/layout_categorias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_volver_cafeterias">

        <!-- Este empieza ACTIVO por defecto -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cerca"
            style="@style/EstiloBotonFiltroActivo"
            android:text="Cerca de ti" />

        <!-- Estos dos empiezan INACTIVOS -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_populares"
            style="@style/EstiloBotonFiltro"
            android:text="Populares" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_abierto"
            style="@style/EstiloBotonFiltro"
            android:layout_marginEnd="0dp"
            android:text="Abierto" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_cafeterias"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/layout_categorias"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>