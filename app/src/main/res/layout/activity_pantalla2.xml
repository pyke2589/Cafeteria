<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Pantalla2">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/contenedor_principal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/Layoutuno" />

    <!-- Barra de Navegación (Limpiada y usando Estilo) -->
    <LinearLayout
        android:id="@+id/Layoutuno"
        style="@style/EstiloBarraNavegacion"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Botón 1: Mapa -->
        <LinearLayout
            android:id="@+id/Layoutdos"
            style="@style/EstiloContenedorTabNav">
            <ImageView
                android:id="@+id/IconoMap"
                style="@style/EstiloIconoNav"
                android:src="@drawable/icono_google"/>
            <TextView
                android:id="@+id/NombreMapa"
                style="@style/EstiloTextoMenuNavegacion"
                android:text="@string/textgoomap"/>
        </LinearLayout>

        <!-- Botón 2: Cafeterías -->
        <LinearLayout
            android:id="@+id/Layouttres"
            style="@style/EstiloContenedorTabNav">
            <ImageView
                android:id="@+id/Iconocafeterias"
                style="@style/EstiloIconoNav"
                android:src="@drawable/icono_cafe"/>
            <TextView
                android:id="@+id/Nombrecafe"
                style="@style/EstiloTextoMenuNavegacion"
                android:text="Cafeterías"/>
        </LinearLayout>

        <!-- Botón 3: Perfil -->
        <LinearLayout
            android:id="@+id/Layoutcuatro"
            style="@style/EstiloContenedorTabNav">
            <ImageView
                android:id="@+id/Iconoperfil"
                style="@style/EstiloIconoNav"
                android:src="@drawable/icono_perfil"/>
            <TextView
                android:id="@+id/Nombreperfil"
                style="@style/EstiloTextoMenuNavegacion"
                android:text="Perfil"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>