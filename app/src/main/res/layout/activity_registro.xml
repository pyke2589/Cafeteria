<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#FAF5EB"> <!-- Fondo crema -->

    <!-- Botón volver atrás superior izquierdo -->
    <ImageButton
        android:id="@+id/btn_volver_superior"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@android:drawable/ic_menu_revert"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:onClick="volverLogin"
        android:contentDescription="Volver atrás"
        android:scaleType="centerInside"
        app:tint="#5D4037"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Título Principal -->
    <TextView
        android:id="@+id/titulo_coffeespot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CoffeeSpot"
        android:textColor="#4E342E"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/subtitulo_crear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Crear Cuenta"
        android:textColor="#6D4C41"
        android:textSize="18sp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titulo_coffeespot" />

    <!-- Recuadro para los campos (CardView para un diseño más moderno) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/contenedor_campos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@+id/subtitulo_crear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Campo 1: Nombre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre de Usuario:"
                android:textStyle="bold"
                android:textColor="#795548"/>
            <EditText
                android:id="@+id/reg_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#F3A683"
                android:hint="Ej. Ramiro"
                android:textColorHint="#BCAAA4"
                android:inputType="textPersonName"
                android:textColor="#3E2723"
                android:paddingVertical="8dp"/>

            <!-- Campo 2: Correo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correo Electrónico:"
                android:textStyle="bold"
                android:textColor="#795548"
                android:layout_marginTop="12dp"/>
            <EditText
                android:id="@+id/reg_correo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#F3A683"
                android:hint="ejemplo@gmail.com"
                android:textColorHint="#BCAAA4"
                android:inputType="textEmailAddress"
                android:textColor="#3E2723"
                android:paddingVertical="8dp"/>

            <!-- Campo 3: Teléfono -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Teléfono:"
                android:textStyle="bold"
                android:textColor="#795548"
                android:layout_marginTop="12dp"/>
            <EditText
                android:id="@+id/reg_telefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#F3A683"
                android:hint="64187898"
                android:textColorHint="#BCAAA4"
                android:inputType="phone"
                android:textColor="#3E2723"
                android:paddingVertical="8dp"/>

            <!-- Campo 4: Contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contraseña:"
                android:textStyle="bold"
                android:textColor="#795548"
                android:layout_marginTop="12dp"/>
            <EditText
                android:id="@+id/reg_pass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#F3A683"
                android:hint="•••••••"
                android:textColorHint="#BCAAA4"
                android:inputType="textPassword"
                android:textColor="#3E2723"
                android:paddingVertical="8dp"/>

            <!-- Campo 5: Confirmar Contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirmar Contraseña:"
                android:textStyle="bold"
                android:textColor="#795548"
                android:layout_marginTop="12dp"/>
            <EditText
                android:id="@+id/reg_pass_conf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#F3A683"
                android:hint="•••••••"
                android:textColorHint="#BCAAA4"
                android:inputType="textPassword"
                android:textColor="#3E2723"
                android:paddingVertical="8dp"/>

            <!-- Botón Registrarse -->
            <Button
                android:id="@+id/btn_registrar_final"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:backgroundTint="#5D4037"
                android:text="Registrarse"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:onClick="completarRegistro"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Texto de Iniciar Sesión (Abajo) -->
    <TextView
        android:id="@+id/txt_volver_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Ya tienes cuenta? Inicia sesión"
        android:textColor="#5D4037"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="32dp"
        android:layout_marginTop="24dp"
        android:padding="8dp"
        android:onClick="volverLogin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/contenedor_campos"
        app:layout_constraintVertical_bias="1.0" />

</androidx.constraintlayout.widget.ConstraintLayout>
