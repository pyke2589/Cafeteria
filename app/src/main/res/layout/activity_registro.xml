<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF5EB"> <!-- Fondo crema -->

    <!-- Botón volver atrás superior izquierdo -->
    <ImageView
        android:id="@+id/btn_volver_superior"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@android:drawable/ic_menu_revert"
        android:backgroundTint="#F3A683"
        android:background="@drawable/logocoffeespot2"
        android:onClick="volverLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Título Principal -->
    <TextView
        android:id="@+id/titulo_coffeespot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CoffeeSpot"
        android:textColor="#5D4037"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/subtitulo_crear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Crear Cuenta"
        android:textColor="#3E2723"
        android:textSize="20sp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titulo_coffeespot" />

    <!-- Recuadro Verde Claro con los campos -->
    <LinearLayout
        android:id="@+id/contenedor_verde"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:background="#E8F5E9"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@+id/subtitulo_crear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Campo 1: Nombre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre de Usuario:"
            android:textColor="#3E2723"/>
        <EditText
            android:id="@+id/reg_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#F3A683"
            android:hint="Ej. Ramiro"
            android:inputType="textPersonName"
            android:textColor="#3E2723" />

        <!-- Campo 2: Correo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Correo Electrónico:"
            android:textColor="#3E2723"
            android:layout_marginTop="12dp"/>
        <EditText
            android:id="@+id/reg_correo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#F3A683"
            android:hint="ejemplo@gmail.com"
            android:inputType="textEmailAddress"
            android:textColor="#3E2723" />

        <!-- Campo 3: Teléfono -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Teléfono:"
            android:textColor="#3E2723"
            android:layout_marginTop="12dp"/>
        <EditText
            android:id="@+id/reg_telefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#F3A683"
            android:hint="64187898"
            android:inputType="phone"
            android:textColor="#3E2723" />

        <!-- Campo 4: Contraseña -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contraseña:"
            android:textColor="#3E2723"
            android:layout_marginTop="12dp"/>
        <EditText
            android:id="@+id/reg_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#F3A683"
            android:hint="1234567"
            android:inputType="textPassword"
            android:textColor="#3E2723" />

        <!-- Campo 5: Confirmar Contraseña -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirmar Contraseña:"
            android:textColor="#3E2723"
            android:layout_marginTop="12dp"/>
        <EditText
            android:id="@+id/reg_pass_conf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#F3A683"
            android:hint="1234567"
            android:inputType="textPassword"
            android:textColor="#3E2723" />

        <!-- Botón Registrarse (Dentro del cuadro verde) -->
        <Button
            android:id="@+id/btn_registrar_final"
            android:layout_width="160dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:backgroundTint="#F5E6CC"
            android:text="Registrarse"
            android:textColor="#3E2723"
            android:textAllCaps="false"
            android:onClick="completarRegistro"/>
    </LinearLayout>

    <!-- Texto de Iniciar Sesión (Abajo) -->
    <TextView
        android:id="@+id/txt_volver_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Ya tienes cuenta? Inicia sesión"
        android:textColor="#5D4037"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="32dp"
        android:onClick="volverLogin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>