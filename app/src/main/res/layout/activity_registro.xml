<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/crema_fondo">

    <!-- Botón volver atrás superior izquierdo (Usando Estilo) -->
    <ImageButton
        android:id="@+id/btn_volver_superior"
        style="@style/EstiloIconoBoton"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@android:drawable/ic_menu_revert"
        android:onClick="volverLogin"
        android:contentDescription="Volver atrás"
        android:scaleType="centerInside"
        app:tint="@color/cafe_claro_texto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Título Principal -->
    <TextView
        android:id="@+id/titulo_coffeespot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/cafe_oscuro_texto"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/subtitulo_crear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_crear"
        android:textColor="@color/cafe_suave"
        android:textSize="18sp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titulo_coffeespot" />

    <!-- Recuadro para los campos (CardView) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/contenedor_campos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/subtitulo_crear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Campo 1: Nombre -->
            <TextView
                style="@style/EstiloEtiquetaFormulario"
                android:layout_marginTop="0dp"
                android:text="Nombre de Usuario:" />
            <EditText
                android:id="@+id/reg_nombre"
                style="@style/EstiloInputFormulario"
                android:hint="Ej. Ramiro"
                android:inputType="textPersonName" />

            <!-- Campo 2: Correo -->
            <TextView
                style="@style/EstiloEtiquetaFormulario"
                android:text="Correo Electrónico:" />
            <EditText
                android:id="@+id/reg_correo"
                style="@style/EstiloInputFormulario"
                android:hint="@string/hint_correo"
                android:inputType="textEmailAddress" />

            <!-- Campo 3: Teléfono -->
            <TextView
                style="@style/EstiloEtiquetaFormulario"
                android:text="Teléfono:" />
            <EditText
                android:id="@+id/reg_telefono"
                style="@style/EstiloInputFormulario"
                android:hint="64187898"
                android:inputType="phone" />

            <!-- Campo 4: Contraseña -->
            <TextView
                style="@style/EstiloEtiquetaFormulario"
                android:text="Contraseña:" />
            <EditText
                android:id="@+id/reg_pass"
                style="@style/EstiloInputFormulario"
                android:hint="@string/hint_contrasena"
                android:inputType="textPassword" />

            <!-- Campo 5: Confirmar Contraseña -->
            <TextView
                style="@style/EstiloEtiquetaFormulario"
                android:text="Confirmar Contraseña:" />
            <EditText
                android:id="@+id/reg_pass_conf"
                style="@style/EstiloInputFormulario"
                android:hint="@string/hint_contrasena"
                android:inputType="textPassword" />

            <!-- Botón Registrarse (Usando Estilo Centralizado) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_registrar_final"
                style="@style/EstiloBotonPrincipal"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:onClick="completarRegistro"
                android:text="Registrarse" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Texto de Iniciar Sesión (Abajo) -->
    <TextView
        android:id="@+id/txt_volver_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Ya tienes cuenta? Inicia sesión"
        android:textColor="@color/cafe_claro_texto"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="32dp"
        android:layout_marginTop="24dp"
        android:padding="8dp"
        android:onClick="volverLogin"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/contenedor_campos"
        app:layout_constraintVertical_bias="1.0" />

</androidx.constraintlayout.widget.ConstraintLayout>