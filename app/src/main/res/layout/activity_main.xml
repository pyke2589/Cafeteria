<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cafe_fondo"
    android:padding="32dp">

    <!-- Logo central -->
    <ImageView
        android:id="@+id/logo_app"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/logocoffeespot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Etiqueta Correo -->
    <TextView
        android:id="@+id/lbl_correo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_correo"
        android:textColor="@color/crema_fondo"
        android:textStyle="bold"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_app" />

    <!-- Campo Correo redondeado -->
    <EditText
        android:id="@+id/input_correo"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/fondo_redondeado_crema"
        android:backgroundTint="@color/crema_fondo"
        android:paddingHorizontal="20dp"
        android:textColor="@color/cafe_oscuro_texto"
        android:textColorHint="@color/cafe_suave"
        android:hint="@string/hint_correo"
        android:inputType="textEmailAddress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lbl_correo" />

    <!-- Etiqueta Contraseña -->
    <TextView
        android:id="@+id/lbl_contrasena"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_contrasena"
        android:textColor="@color/crema_fondo"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_correo" />

    <!-- Campo Contraseña redondeado con toggle de visibilidad (Ojo) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_input_contrasena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:hintEnabled="false"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/cafe_suave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lbl_contrasena">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_contrasena"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/fondo_redondeado_crema"
            android:backgroundTint="@color/crema_fondo"
            android:paddingHorizontal="20dp"
            android:textColor="@color/cafe_oscuro_texto"
            android:textColorHint="@color/cafe_suave"
            android:hint="@string/hint_contrasena"
            android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Botón Iniciar Sesión (Usa el Style centralizado) -->
    <Button
        android:id="@+id/btn_ingresar"
        style="@style/EstiloBotonCafe"
        android:layout_marginTop="40dp"
        android:onClick="ingresarApp"
        android:text="@string/btn_iniciar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_input_contrasena" />

    <!-- Botón Crear Cuenta (Usa el Style centralizado) -->
    <Button
        android:id="@+id/btn_crear_cuenta"
        style="@style/EstiloBotonCafe"
        android:layout_marginTop="16dp"
        android:onClick="crearCuenta"
        android:text="@string/btn_crear"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_ingresar" />

</androidx.constraintlayout.widget.ConstraintLayout>